# Keep this file inside the tool directory when copied to tools/erd-generator/.
# Leading slashes are relative to this .gitignore, not the parent repository.

# Python environments and caches.
/.venv/
/venv/
/env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Build, packaging and coverage outputs.
/build/
/dist/
*.egg-info/
.eggs/
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Local editor, OS and environment settings.
.idea/
.vscode/
.DS_Store
.env
.env.*
!.env.example

# Generated diagrams, diagnostics and retired presentation assets.
/generated/
/parse_log/
*.partial.d2
*.partial.svg
/TECH_SHARING_PPT.md
/video.mp4

# Local planning and validation notes; excluded from the public repository.
/docs/plans/
/docs/validation/

# Local SQL inputs and retired demonstration assets.
/migrations/
/db/migration/
/sample_fk_config.yaml
/scripts/benchmark_rendering.py
/tests/fixtures/library_30_tables.sql
/tests/fixtures/simple.sql
/tests/fixtures/simple.d2
